# ServiceNow OAuth — copy to .env and fill locally. NEVER commit the real file.
SN_INSTANCE=https://<SN_INSTANCE>.service-now.com
SN_CLIENT_ID=<CLIENT_ID>
SN_CLIENT_SECRET=<SET_IN_KEY_VAULT_NOT_HERE>
SN_TOKEN_URL=https://<SN_INSTANCE>.service-now.com/oauth_token.do

# Behaviour tuning
DEFLECTION_CONFIDENCE_THRESHOLD=0.75
MAX_DEFLECTION_ATTEMPTS=2
TRANSCRIPT_MAX_TURNS=30
